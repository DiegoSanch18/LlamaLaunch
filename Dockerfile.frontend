FROM nginx:alpine

LABEL maintainer="DiegoSanch18"
LABEL description="LlamaLaunch Decoupled Web Frontend (:3000) served via Nginx"

# Remove default nginx website
RUN rm -rf /usr/share/nginx/html/*

# Copy custom nginx reverse-proxy configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy static frontend assets (HTML5, CSS3, Vanilla JS, icons)
COPY llamaLauncher/app/frontend /usr/share/nginx/html

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]

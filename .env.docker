# ==============================================================================
# Variables de Entorno para LlamaLaunch Docker Compose
# ==============================================================================

# 1. Puertos de Servicios Desacoplados
WEB_PORT=3000
BACKEND_PORT=5000
GATEWAY_PORT=8082

# 2. Rutas de Modelos y Almacenamiento Local
MODELS_DIR=G:/My Drive/AI Local/models

# 3. Integración con Redes y Nodos de Inferencia
DEFAULT_LOCAL_BACKEND=http://host.docker.internal:8080
DESKTOP_BACKEND_URL=http://host.docker.internal:8080
LAPTOP_BACKEND_URL=http://host.docker.internal:8080
TRUENAS_BACKEND_URL=http://truenas.local:8080

# 4. Enrutamiento hacia Atomic AI Proxy y Gateway
GATEWAY_URL=http://gateway:8082
ATOMIC_PROXY_URL=http://host.docker.internal:8000

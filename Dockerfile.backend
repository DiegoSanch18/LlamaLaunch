FROM python:3.11-slim

LABEL maintainer="DiegoSanch18"
LABEL description="LlamaLaunch Decoupled Backend API (:5000) - Standalone Service"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    BACKEND_HOST=0.0.0.0 \
    BACKEND_PORT=5000 \
    LLAMALAUNCH_MODELS_DIR=/app/models

WORKDIR /app

# Install lightweight backend dependencies
RUN pip install --no-cache-dir bottle requests psutil

# Copy application source code
COPY . /app/

# Port 5000: LlamaLaunch Backend API & JSON-RPC Bridge
EXPOSE 5000

CMD ["python", "llamaLauncher/backend_server.py"]
